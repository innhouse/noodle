rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Meal photos from Noodle's food-tracking days, one folder per user. Nothing
    // writes here any more; the rule exists so the owner can list and delete what
    // is left, and so nobody else can.
    match /users/{uid}/meals/{photo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
  }
}
