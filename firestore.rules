rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything a person logs lives under their own uid and is readable only by
    // them. Noodle is single-user by design, so there is no sharing path at all —
    // no rule here grants one account access to another's food or weight history.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // The USDA lookup cache is shared across users and written only by the Cloud
    // Function, which bypasses these rules via the Admin SDK. Nutrition facts for
    // "chicken breast, roasted" are public data, so reads are open to signed-in
    // clients; writes are closed so a client cannot poison the cache.
    match /usdaCache/{entry} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
