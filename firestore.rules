rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything a person logs lives under their own uid and is readable only by
    // them. Noodle is single-user by design, so there is no sharing path at all —
    // no rule here grants one account access to another's workouts or weight history.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
